// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminLogin {
  id        Int     @id @default(autoincrement())
  username  String
  timestamp String
  ip        String?
  userAgent String?
  status    String?
}

model AdminSession {
  token     String @id
  createdAt String
  lastUsed  String
}

model Booking {
  id          String  @id @default(uuid())
  name        String?
  email       String?
  phone       String?
  date        String?
  startDate   String?
  endDate     String?
  bookingType String?
  startTime   String?
  endTime     String?
  reason      String?
  attendees   String?
  remarks     String?
  food        String?
  foodSpecify String?
  foodCount   Int?
  createdAt   String?
  status      String?
}

model HelpdeskRequest {
  id          String  @id @default(uuid())
  category    String?
  name        String?
  email       String?
  phone       String?
  location    String?
  description String?
  items       String?
  status      String?
  createdAt   String?
  resolution  String?
}

model AmcContract {
  id             String     @id @default(uuid())
  doc_no         String?
  amc_name       String?
  category       String?
  no_of_visits   Int?
  units_location String?
  pricing        Float?
  frequency      String?
  start_date     String?
  end_date       String?
  last_service   String?
  next_service   String?
  vendor_contact String?
  vendor_phone   String?
  coverage_specs String?
  status         String?    @default("Active")
  created_at     String?
  visits         AmcVisit[]
}

model AmcVisit {
  id                String      @id @default(uuid())
  amc_id            String
  visit_no          Int?
  scheduled_date    String?
  last_service_date String?
  next_service_date String?
  service_no        String?
  service_person    String?
  contact_number    String?
  remarks           String?
  status            String?     @default("Pending")
  created_at        String?
  contract          AmcContract @relation(fields: [amc_id], references: [id], onDelete: Cascade)
}

model UtilityPayment {
  id              String  @id @default(uuid())
  utility_type    String?
  provider_name   String?
  account_number  String?
  billing_cycle   String?
  due_date        String?
  amount          Float?
  status          String?
  payment_date    String?
  transaction_ref String?
  remarks         String?
  created_at      String?
}

model TaxPayment {
  id              String  @id @default(uuid())
  tax_type        String?
  location        String?
  bill_no         String?
  year            String?
  term            String?
  due_date        String?
  amount          Float?
  status          String?
  payment_date    String?
  transaction_ref String?
  remarks         String?
  created_at      String?
}

model InventoryItem {
  id           String                   @id @default(uuid())
  category     String // 'stationery' or 'housekeeping'
  name         String
  currentStock Int                      @default(0)
  updatedAt    String?
  transactions InventoryTransaction[]
  overrides    InventoryAuditOverride[]
}

model InventoryTransaction {
  id            String        @id @default(uuid())
  itemId        String
  type          String // 'purchase' or 'use'
  quantity      Int
  previousStock Int
  newStock      Int
  timestamp     String
  remarks       String?
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model InventoryAuditOverride {
  id            String        @id @default(uuid())
  itemId        String
  month         String // e.g. "2026-06"
  startingStock Int?
  purchased     Int?
  used          Int?
  endingStock   Int?
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model EmployeeCredential {
  email        String @id
  passwordHash String
}

model AssetHandover {
  id             String              @id @default(uuid())
  name           String
  email          String
  department     String?
  handoverDate   String
  handoverBy     String?
  status         String              @default("Pending Acknowledgement")
  acknowledgedAt String?
  signature      String?
  remarks        String?
  createdAt      String
  updatedAt      String
  items          AssetHandoverItem[]
}

model AssetHandoverItem {
  id         String        @id @default(uuid())
  handoverId String
  itemName   String
  serialNo   String?
  condition  String?       @default("Good")
  status     String?       @default("Assigned")
  returnedAt String?
  remarks    String?
  handover   AssetHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
}

model CourierDispatch {
  id                String                @id @default(uuid())
  dcNo              String
  dcDate            String
  remarksType       String                @default("Service")
  remarksOther      String?
  transporterName   String?
  transporterAmount Float?
  docketNo          String?
  noOfBoxes         Int                   @default(1)
  courierBilling    String?
  signatoryCompany  String?
  fromAddressText   String?
  senderName        String
  senderPhone       String?
  toAddress         String
  receiverName      String
  receiverPhone     String?
  totalAmount       Float                 @default(0)
  dimensions        String?
  weight            String?
  status            String                @default("approved")
  approvalToken     String?
  requesterEmail    String
  submittedAt       String
  updatedAt         String
  parentDispatchId  String?
  mergedRequesters  String?
  items             CourierDispatchItem[]
  mergeRequests     CourierMergeRequest[]
}

model CourierDispatchItem {
  id          String          @id @default(uuid())
  dispatchId  String
  itemCode    String?
  description String
  serialNo    String?
  qty         Int             @default(1)
  rate        Float           @default(0)
  value       Float           @default(0)
  dispatch    CourierDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
}

model CourierMergeRequest {
  id               String          @id @default(uuid())
  targetDispatchId String
  requesterEmail   String
  requesterName    String?
  itemsJson        String
  status           String          @default("pending") // pending, approved, rejected
  approvalToken    String?         @unique
  rejectionReason  String?
  createdAt        String
  updatedAt        String
  targetDispatch   CourierDispatch @relation(fields: [targetDispatchId], references: [id], onDelete: Cascade)
}

model PettyCash {
  id            String  @id @default(uuid())
  date          String
  reason        String
  company       String?
  expenseName   String?
  collectedFrom String?
  amount        Float   @default(0)
  type          String  @default("EXPENSE") // 'EXPENSE' or 'ADD_FUNDS'
  remarks       String?
  cleared       Boolean @default(false)
  clearedDate   String?
  createdAt     String
  updatedAt     String
}

model TravelExpense {
  id           String  @id @default(uuid())
  date         String
  employeeName String?
  vehicleNo    String?
  fromLoc      String
  toLoc        String
  mode         String  @default("Bike")
  totalKm      Float   @default(0)
  fuelLiters   Float?
  fuelCost     Float?
  tollParking  Float?
  totalExpense Float   @default(0)
  remarks      String?
  createdAt    String
  updatedAt    String
}

model BillWarranty {
  id               String  @id @default(uuid())
  date             String
  billNo           String
  vendorName       String?
  itemsJson        String?
  totalAmount      Float   @default(0)
  warrantyDate     String?
  billFileUrl      String?
  billFileName     String?
  warrantyFileUrl  String?
  warrantyFileName String?
  approvedBy       String?
  remarks          String?
  createdAt        String
  updatedAt        String
}

model OtherStock {
  id               String  @id @default(uuid())
  stockName        String
  availableQty     Int     @default(0)
  usedQty          Int     @default(0)
  subtitlesJson    String?
  location         String?
  remarks          String?
  usageHistoryJson String?
  createdAt        String
  updatedAt        String
}

model Reminder {
  id         String  @id @default(uuid())
  text       String
  dateTime   String
  priority   String  @default("Medium")
  adminEmail String
  sent       Boolean @default(false)
  sentAt     String?
  createdAt  String
  updatedAt  String
}

model AddressBook {
  id        String  @id @default(uuid())
  userEmail String
  label     String? // Optional friendly label like "Home", "Office"
  name      String
  phone     String?
  address   String
  createdAt String
}

model Location {
  id        String  @id @default(uuid())
  name      String  @unique
  createdAt String?
}

model PurchaseRequest {
  id                  String  @id @default(uuid())
  requestId           String  @unique
  itemName            String
  quantity            Int
  unitAmount          Float
  hasGst              Boolean
  gstPercentage       Float?
  gstAmount           Float   @default(0)
  finalAmount         Float
  modeOfPurchase      String
  storeName           String?
  purchaseLink        String?
  itemImage           String?
  reason              String
  approvalPersonEmail String
  requestedBy         String
  status              String  @default("Pending Approval")
  approverComments    String?
  rejectionReason     String?
  approvalDate        String?
  orderId             String?
  deliveryDate        String?
  exactPurchaseAmount Float?
  purchaseDate        String?
  invoiceFile         String?
  purchaseRemarks     String?
  createdAt           String
  updatedAt           String
}

model AuditLog {
  id        String  @id @default(uuid())
  admin     String  // Admin email or username
  action    String  // Action taken (e.g. APPROVED_BOOKING)
  entity    String  // Entity affected (e.g. Booking, Purchase)
  entityId  String? // ID of the entity
  details   String? // JSON string containing changes or context
  ip        String? // IP address of the admin
  timestamp String  // ISO string
}
